# Selevet Eglantine optimized with a profile merged from Selevet's Mario Kart World profile and
# Donkey Kong Bananza sessions on this machine (bananza.profdata), ThinLTO, Zen 4 tuning.
set(LLVM_ROOT "D:/BuildTools/LLVM")
set(ARCH_FLAGS "-march=x86-64-v3 -mtune=znver4")
set(PROFILE "${CMAKE_CURRENT_LIST_DIR}/bananza.profdata")
set(PGO_FLAGS "${ARCH_FLAGS} /clang:-fprofile-use=${PROFILE} /clang:-Wno-profile-instr-unprofiled /clang:-Wno-profile-instr-out-of-date /clang:-Wno-backend-plugin")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_C_COMPILER "${LLVM_ROOT}/bin/clang-cl.exe" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${LLVM_ROOT}/bin/clang-cl.exe" CACHE FILEPATH "")
set(CMAKE_LINKER "${LLVM_ROOT}/bin/lld-link.exe" CACHE FILEPATH "")
set(CMAKE_AR "${LLVM_ROOT}/bin/llvm-lib.exe" CACHE FILEPATH "")
set(CMAKE_C_FLAGS "/DWIN32 /D_WINDOWS ${PGO_FLAGS}" CACHE STRING "")
set(CMAKE_CXX_FLAGS "/DWIN32 /D_WINDOWS /EHsc ${PGO_FLAGS}" CACHE STRING "")
set(CMAKE_EXE_LINKER_FLAGS "/machine:x64 ${LLVM_ROOT}/lib/clang/23/lib/windows/clang_rt.profile-x86_64.lib" CACHE STRING "")
set(ENABLE_LTO ON CACHE BOOL "")
set(BUILD_TESTING OFF CACHE BOOL "")
set(YUZU_TESTS OFF CACHE BOOL "")
set(YUZU_CMD OFF CACHE BOOL "")
set(YUZU_ROOM OFF CACHE BOOL "")
set(YUZU_ROOM_STANDALONE OFF CACHE BOOL "")
set(YUZU_USE_BUNDLED_SDL3 ON CACHE BOOL "")
set(ENABLE_UPDATE_CHECKER OFF CACHE BOOL "")
set(USE_DISCORD_PRESENCE OFF CACHE BOOL "")
